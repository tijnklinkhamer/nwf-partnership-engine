  "confirmedDefect": {
    "classification": "CONFIRMED_DISCOVERY_RCDATA_MARKUP_HYGIENE_DEFECT",
    "mechanism": "stripNonContent (extract.ts) removes comments and script/style/noscript/svg/template/iframe elements but not title or textarea; extractDiscoveryAnchors and extractDocumentBaseHref (anchors.ts) both scan stripNonContent(html) with regular expressions, so markup-shaped TEXT inside <title> or <textarea> is read as live <a> / <base> elements",
    "htmlSemantics": "title and textarea are RCDATA elements: their content is text, and a '<base ...>' or '<a ...>' inside them never becomes an element",
    "reproducedOfflineAtV5": {
      "extractDocumentBaseHref('<title><base href=\"/fake/\"></title><a href=\"child\">c</a>')": "/fake/",
      "extractDocumentBaseHref('<textarea><base href=\"/fake/\"></textarea><base href=\"/real/\">')": "/fake/",
      "extractDiscoveryAnchors('<title><a href=\"/fake\">t</a></title>')": "one anchor /fake",
      "extractDiscoveryAnchors('<textarea><a href=\"/fake\">t</a></textarea>')": "one anchor /fake"
    },
    "anchorSideDefectPredatesV5": true,
    "baseSideDefectIntroducedWithV5": true,
    "recordedAsKnownLimitationIn": "PHASE_2B_2D_A2_ANCHOR_DOCUMENT_BASE_V5_IMPLEMENTATION_V1.json semanticsImplemented.knownSharedLimitation"
  },
  "whyBeforeFirstLiveV5Use": {
    "reason": "v5 makes the first href-bearing <base> authoritative for resolving EVERY relative link on a page, so one false base captured from title/textarea text would redirect a whole page's relative discovery in one run",
    "v5WorkingCorpusExecutions": 0,
    "ownerDecision": "fix before the first live document-base revalidation"
  },
