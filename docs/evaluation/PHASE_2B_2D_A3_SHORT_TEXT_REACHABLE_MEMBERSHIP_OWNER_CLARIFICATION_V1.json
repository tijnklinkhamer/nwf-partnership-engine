    "perOrganisationStatement": {
      "variables": {
        "c": "the sample's frozen per-organisation cap, c in {8 (SET_P), 4 (SET_R)}",
        "m": "the number of the organisation's survivors in one admissible short-text treatment, a non-negative integer"
      },
      "initialSelectedMembership": "min(c, m)",
      "remainingSurvivors": "m - min(c, m)",
      "legalCapHeadroom": "c - min(c, m)",
      "claim": "min(m - min(c, m), c - min(c, m)) = 0 for every non-negative integer m",
      "proof": "If m <= c then min(c, m) = m and remainingSurvivors = 0. If m > c then min(c, m) = c and legalCapHeadroom = 0. The two cases are exhaustive, so for no m are both positive.",
