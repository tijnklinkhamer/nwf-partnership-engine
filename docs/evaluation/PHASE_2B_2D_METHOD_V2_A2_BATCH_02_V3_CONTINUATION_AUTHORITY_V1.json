    "lowRawYieldDefinition": "a completed continuation run whose RAW orgunit_page_evidence count is < 4",
    "runningCount": "1 + number of completed continuation runs with raw pages < 4",
    "threshold": 2,
    "comparison": ">=",
    "evaluatedAfterEachCompletedRun": true,
    "effect": "PAUSE BEFORE STARTING THE NEXT INDEX",
    "workedExamples": [
      "before index 8: count = 1 => CONTINUE; index 8 is authorised to start",
      "index 8 raw < 4  => count becomes 2 => PAUSE_P5_LOW_RAW_YIELD; index 9 must not start",
      "index 8 raw >= 4 => count stays 1 => CONTINUE; index 9 may start",
      "after index 9: record the resulting count; no organisation beyond index 9 is authorised either way"
    ],
    "whyRawAndNotPostSd7": [
      "SD7 is removal-only, so RAW < 4 can never become post-SD7 >= 4. RAW is",
      "therefore the safe early stop signal during the live window. A run with",
      "RAW >= 4 may still fail formal SD9 after deduplication; that is reported",
      "separately and is NOT retroactive evidence that P5 should have fired",
      "earlier. The two measurements are deliberately not conflated."
    ],
