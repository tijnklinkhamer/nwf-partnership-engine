  "policyTransitionRule": {
    "A_futureLiveAcquisition": {
      "everyNewAcquisitionRunAfterThisAmendmentMustUse": "orgunit-fetch-policy-v2",
      "noNewV1AcquisitionRunIsPermitted": true,
      "thisIsNotAChoiceTheOperatorMakes": "FETCH_POLICY_VERSION is a production constant in src/orgunits/web/policy.ts. The build implements exactly one version, and a run whose recorded policy version this build does not implement is REFUSED by the gateway. There is no flag, argument or environment variable that selects v1."
    },
    "B_preRepairV1Runs": {
      "aHistoricalV1AcquisitionMayRemainAcquisitionOfRecordOnlyIf": "the Option-B code path could not have changed that run's robots outcome",
      "predicateName": "OPTION_B_RELEVANT_V1_RUN",
      "predicateDefinition": "true iff the persisted v1 evidence for that run contains a robots.txt redirect observation for which the LANDED `continuationTargetFor` returns a continuation target",
      "predicateSource": "src/orgunits/web/robots.ts",
      "predicateIsCalledNotReimplemented": true,
      "whenFalse": {
        "classification": "V1_COMPATIBLE_WITH_V2_TRANSITION",
        "mayRemainAcquisitionOfRecord": true
      },
      "whenTrue": {
        "classification": "POLICY_TRANSITION_AFFECTED",
        "mustNotRemainTheGenerationsFinalAcquisitionResultIfAValidV2RevalidationExists": true
      },
      "thisIsPurelyMechanical": true,
      "usesNoLabelNoModelOutputNoCandidateOutcome": true
    },
    "C_whyMixedV1AndV2CanBeConformant": {
      "statement": "Where the v2 branch was mechanically unreachable, the behavioural acquisition path for that run is byte-for-byte what v2 would do. The policy version string differs; the behaviour does not.",
      "whatThisAvoids": [
        "unnecessary repeat institution contact",
        "site-time drift between the original acquisition and a pointless re-acquisition",
        "adaptive retries of unrelated external failures"
      ],
      "blindReAcquisitionOfEveryEarlierV1OrganisationIsNotRequired": true
    },
    "D_whatTheCorpusFreezeMustLaterRecord": {
      "perAcquisitionOfRecord": [
        "run policy version",
        "transition classification",
        "whether a v2 replacement-of-evidence was required"
      ],
      "thisIsProvenanceNotASamplingVariable": true
    }
  },

