  "record": "PHASE_2B_2D_METHOD_V2_ACQUISITION_POLICY_TRANSITION_LEDGER",
  "recordKind": "ACQUISITION_POLICY_TRANSITION_LEDGER_V4_GEN1",
  "generationId": "METHODOLOGY_V2_GEN1",
  "appendOnly": true,
  "isTheCurrentLedgerOfRecord": true,
  "purpose": "Tracks cases where the SAME selected organisation has more than one acquisition run because of an approved acquisition-policy transition. An entry here is NOT a replacement: no reserve is consumed and no selection index changes hands.",

  "supersedesInPlace": false,
  "predecessor": {
    "path": "docs/evaluation/corpus/PHASE_2B_2D_METHOD_V2_ACQUISITION_POLICY_TRANSITION_LEDGER_V3_GEN1.json",
    "sha256": "f994ac91863d83b9693f6e9aaf9864a783bcfe234bf117be83ee8d67841d0b2b",
    "bytes": 8159,
    "editedByThisRecord": false,
    "deletedByThisRecord": false,
    "entryCountAtThatVersion": 3,
    "why": "The V3 ledger is immutable history: it records the transition history as it stood after Option C-lite. A new transition is not an edit to it. This V4 ledger is a NEW current-version record that binds its predecessor by SHA-256 and carries the complete CURRENT transition history forward.",
    "predecessorSelfDeclaredCurrentFlag": "The V3 ledger carries isTheCurrentLedgerOfRecord: true, which was true when it was written. It is NOT rewritten here. Its own immutability clause states the convention this record follows - a later transition is a NEW entry in a NEW ledger version that binds this one by SHA-256 - so supersession travels through that binding, not through an edit."
  },

  "thisIsNotTheReserveReplacementLedger": {
    "statement": "A replacement swaps a selected organisation for a reserve one. A policy transition keeps the same organisation and changes which of its runs is the acquisition of record. Recording the second in the first's ledger would make \"how many reserves have been consumed?\" answerable only by reading a reason column.",
    "reserveReplacementLedgerPath": "docs/evaluation/corpus/PHASE_2B_2D_METHOD_V2_RESERVE_REPLACEMENT_LEDGER_V2_GEN1.json",
    "reserveReplacementLedgerExists": false,
    "reserveConsumedByThisLedger": 0
  },

  "aTransitionedRunNeedNotHaveSucceeded": {
    "statement": "Entries 0 to 2 transitioned a failed run to a SUCCESSFUL one. Entries 3 to 5 transition a failed run to a run that ALSO failed. Both are transitions: the ledger records which run the generation reads, not whether the newer run recovered acquisition.",
    "supersessionTokenIsTheSameForBoth": true,
    "whyTheSameToken": "SUPERSEDED_FOR_GENERATION_ACQUISITION_DECISION_BY_POLICY_REPAIR describes the reason the acquisition of record moved, which is identical in both cases: an approved acquisition-policy repair produced newer evidence under a newer policy version. Minting a second token for a failed-to-failed transition would make the vocabulary encode an outcome it does not mean.",
    "newSupersessionMeaningInvented": false
  },

