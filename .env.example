# NWF Partnership Engine - Phase 1A
#
# LOCAL DEVELOPMENT ONLY. These are deterministic local Docker credentials.
# They are NOT secrets, NOT production values, and are NOT reused from any other
# system. This project has no managed database and no production environment.
#
# Copy to .env before running. .env is gitignored.

# --- Working database (real ingests live here) -------------------------------

# Owner/admin connection. Used ONLY by migrations (npm run db:migrate).
DATABASE_URL_ADMIN=postgres://nwf_owner:local_dev_only@127.0.0.1:55432/nwf_pe

# Ingest role. Least privilege: may INSERT/UPDATE organisations, INSERT
# organisation_sources (never UPDATE/DELETE), and INSERT/UPDATE ingest_runs.
DATABASE_URL_INGEST=postgres://nwf_ingest:local_dev_only@127.0.0.1:55432/nwf_pe

# Read-only role. Used by all `orgs`/`ingest runs` inspection commands.
DATABASE_URL_READONLY=postgres://nwf_readonly:local_dev_only@127.0.0.1:55432/nwf_pe

# --- Test database (integration tests TRUNCATE this one) ---------------------
#
# Deliberately a SEPARATE database. Integration tests truncate tables, so
# pointing them at the working database above would destroy ingested data on
# every `npm run validate`. The test helper refuses any database whose name does
# not end in `_test`.

DATABASE_URL_ADMIN_TEST=postgres://nwf_owner:local_dev_only@127.0.0.1:55432/nwf_pe_test
DATABASE_URL_INGEST_TEST=postgres://nwf_ingest:local_dev_only@127.0.0.1:55432/nwf_pe_test
DATABASE_URL_READONLY_TEST=postgres://nwf_readonly:local_dev_only@127.0.0.1:55432/nwf_pe_test

# Optional. Set to 1 for verbose ingest diagnostics on stderr.
NWF_PE_VERBOSE=0
